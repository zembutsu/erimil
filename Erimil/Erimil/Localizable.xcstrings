      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ 件のファイルをゴミ箱に移動しますか？" : {
      "comment" : "A confirmation message in the \"Delete\" alert that informs the user how many files will be moved to the trash. The argument is the count of files that will be moved.",
      "isCommentAutoGenerated" : true
    },
    "%@ 件のファイルをゴミ箱に移動しますか？\n（⭐%@件は保護されます）" : {
      "comment" : "A confirmation message that asks whether to move selected files to the Trash, with an additional note about protected favorites.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ 件のファイルをゴミ箱に移動しますか？\n（⭐%2$@件は保護されます）"
          }
        }
      }
    },
    "%@ 件の選択が保存されていません。破棄して別の場所に移動しますか？" : {
      "comment" : "A message in an alert dialog that asks the user if they want to discard their unsaved selections when moving to a new source. The number inside the parentheses is the count of selected items.",
      "isCommentAutoGenerated" : true
    },
