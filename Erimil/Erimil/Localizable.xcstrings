{
  "sourceLanguage" : "en",
  "strings" : {
    " › " : {

    },
    " (%@/%@)" : {
      "comment" : "Displays the current image index and the total number of images in the source, formatted as a range.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " (%1$@/%2$@)"
          }
        }
      }
    },
    "(%@)" : {
      "comment" : "A footnote displaying the total size of the cache. The value inside the parentheses is the size of the cache in bytes, formatted with a human-readable suffix.",
      "isCommentAutoGenerated" : true
    },
    "/ %@ %@" : {
      "comment" : "A label displaying the number of selected items, with an indication of whether the selection mode is \"keep\" or \"exclude\". The argument is the string “grid.status.selected”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "/ %1$@ %2$@"
          }
        }
      }
    },
    "%@" : {
      "comment" : "A label showing the number of items in a metadata section. The argument is the count of items in the section.",
      "isCommentAutoGenerated" : true
    },
    "%@ (%@px)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@px)"
          }
        }
      }
    },
    "%@ (JPEG %@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (JPEG %2$@)"
          }
        }
      }
    },
    "%@ / %@" : {
      "comment" : "A label displaying the current image index and the total number of images.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@\n(%@ %@ %@)" : {
      "comment" : "A message in an alert that confirms the deletion of one or more files, including how many of those files are also marked as favorites and will therefore not be permanently deleted. The second argument is the string “grid.alert.trashConfirm”. The third argument is the string “grid.alert.favoritesProtected”. The fifth argument is the string “grid.alert.protected”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@\n(%3$@ %4$@ %5$@)"
          }
        }
      }
    },
