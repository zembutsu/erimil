  "strings" : {
    " › " : {

    },
    " (%@/%@)" : {
      "comment" : "Displays the current image index and the total number of images in the source, formatted as a range.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " (%1$@/%2$@)"
          }
        }
      }
    },
    "(%@)" : {
      "comment" : "A footnote displaying the total size of the cache. The value inside the parentheses is the size of the cache in bytes, formatted with a human-readable suffix.",
      "isCommentAutoGenerated" : true
    },
    "/ %@ 選択" : {
      "comment" : "A text label displaying the number of items currently selected in the thumbnail grid. The text changes based on whether the selection mode is \"keep\" or \"exclude\".",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "A label showing the number of items in a metadata section. The argument is the count of items in the section.",
      "isCommentAutoGenerated" : true
    },
    "%@ (%@px)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@px)"
          }
        }
      }
    },
    "%@ (JPEG %@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (JPEG %2$@)"
          }
        }
      }
    },
    "%@ / %@" : {
      "comment" : "A label displaying the current image index and the total number of images.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
